{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "MINIGRAD_WARNINGS_AS_ERRORS": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-base",
            "hidden": true,
            "inherits": "windows-base",
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug (Ninja)",
            "description": "Writes compile_commands.json. From a terminal, run in Developer PowerShell for VS 2022.",
            "inherits": "msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release (Ninja)",
            "description": "Writes compile_commands.json. From a terminal, run in Developer PowerShell for VS 2022.",
            "inherits": "msvc-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022",
            "description": "Generates a .sln and works from any terminal, but does not write compile_commands.json.",
            "inherits": "windows-base",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64"
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-debug",
            "configurePreset": "msvc-debug"
        },
        {
            "name": "msvc-release",
            "configurePreset": "msvc-release"
        },
        {
            "name": "vs2022-debug",
            "configurePreset": "vs2022",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-release",
            "configurePreset": "vs2022",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "msvc-debug",
            "inherits": "test-base",
            "configurePreset": "msvc-debug"
        },
        {
            "name": "msvc-release",
            "inherits": "test-base",
            "configurePreset": "msvc-release"
        },
        {
            "name": "vs2022-debug",
            "inherits": "test-base",
            "configurePreset": "vs2022",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-release",
            "inherits": "test-base",
            "configurePreset": "vs2022",
            "configuration": "Release"
        }
    ]
}
